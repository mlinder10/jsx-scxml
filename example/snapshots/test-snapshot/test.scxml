  <state id="if-node-hppEOJabwgNyYpSGZ0O_6" metadata="{&quot;nodeType&quot;:&quot;Script&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:script::if-node-hppEOJabwgNyYpSGZ0O_6 ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeStart(nodeName);
        SFVContext.setLastCommandContinue();</script>
        <script>let baseScript = "JmPartbAmbProviderAuthQuery@PalmettoDatabaseQuery";
        
        if (palmettoSession.service.equals(PalmettoConstants.services.RR)) {
          baseScript = "RrbPartbAmbProviderAuthQuery@PalmettoDatabaseQuery";
        }
        
        // current date format is mmddyyyy, needs to be yyyymmdd
        function formatDate(date) {
          date += '';
          return date.substring(4) + date.substring(0, 2) + date.substring(2, 4);
        }
        
        const startDate = formatDate(member.fromDos);
        const endDate = formatDate(member.toDos);
        
        const res = evalScript(
          baseScript,
          provider.npi,
          member.mbi,
          startDate,
          endDate
        );
        if (res.response != PalmettoConstants.WSReturnCodes.OK) {
          SFVLogger.INFO("Invalid " + baseScript + " Response: " + res);
          return;
        }
        
        SFVLogger.INFO("Result: " + res);
        
        const target = res.result[0];
        if (empty(target)) {
          SFVLogger.DEBUG("Invalid prior auth status received
    	From: " + fromDos + "
    	To: " + toDos)
          return;
        }
        
        SFVLogger.INFO("ivr_status: " + target.ivr_status);
        ivrStatus = target.ivr_status;
        
        if (ivrStatus.equals("NON-AFFIRMED")) {
          const tmpParCode = target.ivr_par_codes.indexOf("Y") + 1;
          if (tmpParCode == 0) {
              SFVLogger.DEBUG("PAR Code not found: " + target.ivr_par_codes);
              return
          }
        
          if (tmpParCode != 14) {
              parCode = tmpParCode + "";
              return;
          }
        
          const parCodeLetter = target.ivr_par14_codes.indexOf("Y");
          if (parCodeLetter == -1) {
              SFVLogger.DEBUG("PAR Code 14 letter not found: " + target.ivr_par14_codes);
              return;
          }
        
          parCode = tmpParCode + ["A", "B", "C", "D", "E"][parCodeLetter];
        }</script>
        <else/>
        <sf:log expr="'sf:script::if-node-hppEOJabwgNyYpSGZ0O_6 SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-GxPCtb6ZASKCWBt7J2K9_">
      <assign location="lastEvent" expr="_event"/>
    </transition>
    <onexit>
      <sf:log expr="'sf:script::if-node-hppEOJabwgNyYpSGZ0O_6 ONEXIT'"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeEnd(nodeName);</script>
      </if>
    </onexit>
  </state>
