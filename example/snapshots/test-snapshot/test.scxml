    </transition>
    <onexit>
      <sf:log expr="'sf:script::if-node-nqLZxJ6sOGPASWzS7RCOl ONEXIT'"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeEnd(nodeName);</script>
      </if>
    </onexit>
  </state>
  <state id="if-node-KNZxVCPzVLDxjUZTmAEGp" metadata="{&quot;nodeType&quot;:&quot;Script&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:script::if-node-KNZxVCPzVLDxjUZTmAEGp ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeStart(nodeName);</script>
        <else/>
        <sf:log expr="'sf:script::if-node-KNZxVCPzVLDxjUZTmAEGp SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-5pyiqIEEnDACx7C1N6kMn">
      <assign location="lastEvent" expr="_event"/>
    </transition>
    <onexit>
      <sf:log expr="'sf:script::if-node-KNZxVCPzVLDxjUZTmAEGp ONEXIT'"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeEnd(nodeName);</script>
      </if>
    </onexit>
  </state>
  <state id="if-node-5pyiqIEEnDACx7C1N6kMn" metadata="{&quot;nodeType&quot;:&quot;Script&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:script::if-node-5pyiqIEEnDACx7C1N6kMn ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeStart(nodeName);
        SFVContext.setLastCommandContinue();</script>
        <else/>
        <sf:log expr="'sf:script::if-node-5pyiqIEEnDACx7C1N6kMn SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-DIym83A7vogNce0pmXHUH">
      <assign location="lastEvent" expr="_event"/>
    </transition>
    <onexit>
      <sf:log expr="'sf:script::if-node-5pyiqIEEnDACx7C1N6kMn ONEXIT'"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeEnd(nodeName);
        
        var returnEntityType = lastResult.entityResultValue['repeat_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found repeat_type");
        	lastResult.lastInputLabel = 'Repeat';
        	return;
        }
        
        returnEntityType = lastResult.entityResultValue['another_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found another_type");
        	lastResult.lastInputLabel = 'Another';
        	return;
        }
        
        returnEntityType = lastResult.entityResultValue['main_menu_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found main_menu_type");
        	lastResult.lastInputLabel = 'MainMenu';
        	return;
        }
        
        returnEntityType = lastResult.entityResultValue['agent_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found agent_type");
        	lastResult.lastInputLabel = 'Agent';
        	return;
        }</script>
      </if>
    </onexit>
  </state>
  <state id="if-node-DIym83A7vogNce0pmXHUH" metadata="{&quot;nodeType&quot;:&quot;Branch&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:branch::if-node-DIym83A7vogNce0pmXHUH ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <else/>
        <sf:log expr="'sf:branch::if-node-DIym83A7vogNce0pmXHUH SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition cond="!session.lastCommand.equals(SFVConstants.lastCommand.CONTINUE)" target="if-node-qXrs6Za0xIyvuhJ5rvush">
      <assign location="branchLabel" expr="'Process Last Command'"/>
      <script>SFVContext.logTransition(branchLabel);</script>
    </transition>
    <transition cond="lastResult.lastInputLabel.equalsIgnoreCase('Agent')" target="if-node-qXrs6Za0xIyvuhJ5rvush">
      <assign location="branchLabel" expr="'Agent'"/>
      <script>SFVContext.logTransition(branchLabel);
        SFVContext.setLastCommandSetEvent(SFVConstants.events.AGENT);</script>
    </transition>
    <transition cond="lastResult.lastMenuFail.equalsIgnoreCase('no.match')" target="if-node-qXrs6Za0xIyvuhJ5rvush">
      <assign location="branchLabel" expr="'No Match'"/>
      <script>SFVContext.logTransition(branchLabel);
        SFVContext.setLastCommandSetEvent(SFVConstants.events.MENU_MAX_REC_ATTEMPTS);</script>
    </transition>
    <transition cond="lastResult.lastMenuFail.equalsIgnoreCase('no.input')" target="if-node-qXrs6Za0xIyvuhJ5rvush">
      <assign location="branchLabel" expr="'No Input'"/>
      <script>SFVContext.logTransition(branchLabel);
        SFVContext.setLastCommandSetEvent(SFVConstants.events.MENU_MAX_REC_ATTEMPTS);</script>
    </transition>
    <transition cond="lastResult.lastInputLabel.equalsIgnoreCase('Repeat')" target="if-node-IEShPTmy62gjkChDqgPVS">
      <assign location="branchLabel" expr="'Repeat'"/>
      <script>SFVContext.logTransition(branchLabel);</script>
    </transition>
    <transition cond="lastResult.lastInputLabel.equalsIgnoreCase('Another')" target="if-node-Zs1ToBRMKcP33Z9T3bho6">
      <assign location="branchLabel" expr="'Date Range'"/>
      <script>SFVContext.logTransition(branchLabel);</script>
    </transition>
    <transition cond="lastResult.lastInputLabel.equalsIgnoreCase('MainMenu')" target="if-node-qXrs6Za0xIyvuhJ5rvush">
      <assign location="branchLabel" expr="'Main Menu'"/>
      <script>SFVContext.logTransition(branchLabel);
        
        if (!palmettoSession.jurisdiction.equals('RR')) {
            getSessionContext().setResultValue('intent.collector.flow', PalmettoConstants.intentRouterFlows.JJ_JM_PART_B_IntentRouterFlow);
            palmettoSession.appID = PalmettoConstants.appIDs.AppID_PartB;
            evalScript('updateQualKeyAppID@PalmettoUtilities');
        }
        
        SFVContext.setLastCommandSetEvent(PalmettoConstants.events.RETURN_MAIN_MENU);</script>
    </transition>
    <transition cond="true" target="if-node-qXrs6Za0xIyvuhJ5rvush">
      <assign location="branchLabel" expr="'Other'"/>
      <script>SFVContext.logTransition(branchLabel);
        SFVContext.setLastCommandSetEvent(SFVConstants.events.AGENT);</script>
    </transition>
    <onexit>
      <sf:log expr="'sf:branch::if-node-DIym83A7vogNce0pmXHUH ONEXIT'"/>
    </onexit>
  </state>
  <state id="if-node-BA9YbqpaRdXSTIIO9hCxm" metadata="{&quot;nodeType&quot;:&quot;Script&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:script::if-node-BA9YbqpaRdXSTIIO9hCxm ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeStart(nodeName);</script>
        <else/>
        <sf:log expr="'sf:script::if-node-BA9YbqpaRdXSTIIO9hCxm SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-5pyiqIEEnDACx7C1N6kMn">
      <assign location="lastEvent" expr="_event"/>
    </transition>
    <onexit>
      <sf:log expr="'sf:script::if-node-BA9YbqpaRdXSTIIO9hCxm ONEXIT'"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeEnd(nodeName);</script>
      </if>
    </onexit>
  </state>
  <state id="if-node-nXZmDLlIKDrazAqmslu1j" metadata="{}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'State::if-node-nXZmDLlIKDrazAqmslu1j ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <sf:announcement src="" srcexpr="&quot;Common/PriorAuthStatus/PAStatus_&quot; + parCode"/>
        <else/>
        <sf:log expr="'State::if-node-nXZmDLlIKDrazAqmslu1j SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-5pyiqIEEnDACx7C1N6kMn">
      <assign location="lastEvent" expr="_event"/>
    </transition>
    <onexit>
      <sf:log expr="'State::if-node-nXZmDLlIKDrazAqmslu1j ONEXIT'"/>
    </onexit>
  </state>
</scxml>