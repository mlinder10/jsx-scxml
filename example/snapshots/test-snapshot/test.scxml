      <if cond="lastEnabled">
        <script>SFVContext.logNodeStart(nodeName);</script>
        <else/>
        <sf:log expr="'sf:script::if-node-nqLZxJ6sOGPASWzS7RCOl SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-5pyiqIEEnDACx7C1N6kMn">
