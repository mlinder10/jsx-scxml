    </onexit>
  </state>
  <state id="if-node-hIK_7aKVO2LkX9wnEke6u" metadata="{&quot;nodeType&quot;:&quot;Script&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:script::if-node-hIK_7aKVO2LkX9wnEke6u ONENTRY'"/>
      <assign location="lastEnabled" expr="true"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeStart(nodeName);
        SFVContext.setLastCommandContinue();</script>
        <else/>
        <sf:log expr="'sf:script::if-node-hIK_7aKVO2LkX9wnEke6u SKIPPED; enabled expression evaluated false.'"/>
      </if>
    </onentry>
    <transition event="module.complete" target="if-node-ImfEWOjZbpCqVASz_PKyU">
      <assign location="lastEvent" expr="_event"/>
    </transition>
    <onexit>
      <sf:log expr="'sf:script::if-node-hIK_7aKVO2LkX9wnEke6u ONEXIT'"/>
      <if cond="lastEnabled">
        <script>SFVContext.logNodeEnd(nodeName);
        
        var returnEntityType = lastResult.entityResultValue['replay_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found replay_type");
        	lastResult.lastInputLabel = 'Replay';
        	return;
        }
        
        returnEntityType = lastResult.entityResultValue['another_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found another_type");
        	lastResult.lastInputLabel = 'Reenter';
        	return;
        }
        
        returnEntityType = lastResult.entityResultValue['main_menu_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found main_menu_type");
        	lastResult.lastInputLabel = 'MainMenu';
        	return;
        }
        
        returnEntityType = lastResult.entityResultValue['agent_type'];
        if (!empty(returnEntityType)) {
        	SFVLogger.INFO("Found agent_type");
        	lastResult.lastInputLabel = 'Agent';
        	return;
        }</script>
      </if>
    </onexit>
  </state>
  <state id="if-node-ImfEWOjZbpCqVASz_PKyU" metadata="{&quot;nodeType&quot;:&quot;Branch&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
