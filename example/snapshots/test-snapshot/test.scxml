  <state id="if-node-nqLZxJ6sOGPASWzS7RCOl" metadata="{&quot;nodeType&quot;:&quot;Script&quot;}">
    <onentry>
      <assign location="nodeName" expr="''"/>
      <sf:log expr="'sf:script::if-node-nqLZxJ6sOGPASWzS7RCOl ONENTRY'"/>
